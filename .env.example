# Nur Beispielwerte. Kopieren nach .env.local und dort ersetzen.
# Niemals echte Zugangsdaten ins Repository einchecken.
RESEND_API_KEY=replace_with_your_resend_api_key
# Muss zu einer in Resend verifizierten eigenen Domain gehören.
CONTACT_FROM_EMAIL="Hägele & Siebert Grundstückspflege <anfragen@example.com>"
# Öffentliche Hauptadresse, z. B. https://ihre-domain.de (keine Beispieladresse übernehmen).
# Solange die Domain offen ist, leer lassen.
SITE_URL=
